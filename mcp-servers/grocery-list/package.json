{
    "name": "grocery-list-mcp",
    "version": "1.0.0",
    "description": "A comprehensive grocery list management MCP server with price tracking, frequency analysis, and receipt processing",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "tsc && node dist/index.js",
        "test": "npm run build && node tests/run-all-tests.js",
        "test:unit": "npm run build && node tests/unit/grocery-manager.test.js && node tests/unit/web-ui-integration.test.js",
        "test:integration": "npm run build && node tests/integration/mcp-server.test.js",
        "test:utilities": "npm run build && node tests/helpers/test-utilities-validation.js",
        "test:legacy": "npm run build && node test-basic.js && node test-api-endpoints.js",
        "test:watch": "npm run build && node tests/run-all-tests.js",
        "test:cleanup": "node -e \"import('./tests/helpers/test-utilities.js').then(m => m.cleanupTestEnvironment())\"",
        "lint": "eslint src --ext .ts",
        "format": "prettier --write src tests"
    },
    "keywords": [
        "mcp",
        "grocery",
        "shopping",
        "price-tracking",
        "receipt-processing",
        "typescript",
        "librechat"
    ],
    "author": "MCP Community",
    "license": "MIT",
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.11.1",
        "dotenv": "^16.5.0",
        "mcp-data": "^1.0.1",
        "mcp-web-ui": "^1.1.2"
    },
    "devDependencies": {
        "@types/chai": "^4.3.11",
        "@types/mocha": "^10.0.6",
        "@types/node": "^20.11.24",
        "@typescript-eslint/eslint-plugin": "^6.21.0",
        "@typescript-eslint/parser": "^6.21.0",
        "chai": "^4.3.10",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.1.3",
        "esmock": "^2.7.0",
        "mocha": "^10.2.0",
        "prettier": "^3.2.5",
        "typescript": "^5.3.3"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/your-org/mcp-servers.git",
        "directory": "grocery-list"
    },
    "bugs": {
        "url": "https://github.com/your-org/mcp-servers/issues"
    },
    "homepage": "https://github.com/your-org/mcp-servers/tree/main/grocery-list#readme"
}
