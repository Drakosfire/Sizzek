{
    "name": "grocery-list-mcp",
    "version": "1.0.0",
    "description": "A comprehensive grocery list management MCP server with price tracking, frequency analysis, and receipt processing",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "tsc && node dist/index.js",
        "test": "npm run build && mocha 'tests/**/*.test.js' --timeout 30000 --exit",
        "test:unit": "npm run build && mocha 'tests/unit/**/*.test.js' --timeout 30000 --exit",
        "test:integration": "npm run build && mocha 'tests/integration/**/*.test.js' --timeout 30000 --exit",
        "test:watch": "npm run build && mocha 'tests/**/*.test.js' --timeout 30000 --watch",
        "test:cleanup": "node tests/helpers/cleanup-test-data.js",
        "lint": "eslint src --ext .ts",
        "format": "prettier --write src tests"
    },
    "keywords": [
        "mcp",
        "grocery",
        "shopping",
        "price-tracking",
        "receipt-processing",
        "typescript",
        "librechat"
    ],
    "author": "MCP Community",
    "license": "MIT",
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.11.1",
        "mcp-data": "mcp-data",
        "mcp-web-ui": "file:../../../mcp-web-ui-standalone",
        "dotenv": "^16.5.0"
    },
    "devDependencies": {
        "@types/chai": "^4.3.11",
        "@types/mocha": "^10.0.6",
        "@types/node": "^20.11.24",
        "@typescript-eslint/eslint-plugin": "^6.21.0",
        "@typescript-eslint/parser": "^6.21.0",
        "chai": "^4.3.10",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.1.3",
        "esmock": "^2.7.0",
        "mocha": "^10.2.0",
        "prettier": "^3.2.5",
        "typescript": "^5.3.3"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/your-org/mcp-servers.git",
        "directory": "grocery-list"
    },
    "bugs": {
        "url": "https://github.com/your-org/mcp-servers/issues"
    },
    "homepage": "https://github.com/your-org/mcp-servers/tree/main/grocery-list#readme"
}