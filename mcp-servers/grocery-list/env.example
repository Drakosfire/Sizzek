# Grocery List MCP Server Configuration

# ===== STORAGE CONFIGURATION =====
# Storage type: 'json' or 'mongodb'
MCP_STORAGE_TYPE=json

# ===== JSON FILE STORAGE (when MCP_STORAGE_TYPE=json) =====
# Path to grocery data file (relative or absolute)
GROCERY_FILE_PATH=./grocery-data.json

# ===== MONGODB STORAGE (when MCP_STORAGE_TYPE=mongodb) =====
# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/LibreChat

# MongoDB database name (default: LibreChat)
MONGODB_DATABASE=LibreChat

# MongoDB collection name for grocery data
MONGODB_COLLECTION=user_grocery_data

# MongoDB connection timeout (milliseconds)
MCP_MONGODB_TIMEOUT=10000

# MongoDB max retries
MCP_MONGODB_RETRIES=3

# ===== USER ISOLATION =====
# Enable user-based storage (set by LibreChat)
MCP_USER_BASED=true

# User ID (passed by LibreChat automatically)
MCP_USER_ID=${USER_ID}

# ===== ENCRYPTION (Optional - for sensitive grocery data) =====
# Encryption key (64-character hex string)
# Uses LibreChat's CREDS_KEY if available
CREDS_KEY=your-64-character-hex-encryption-key

# ===== GROCERY-SPECIFIC CONFIGURATION =====
# Default store for new items
GROCERY_DEFAULT_STORE=Kroger

# Enable price tracking features
GROCERY_ENABLE_PRICE_TRACKING=true

# Enable receipt processing features
GROCERY_ENABLE_RECEIPT_PROCESSING=true

# Enable budget tracking and alerts
GROCERY_BUDGET_ALERTS=true

# Default budget limits (monthly)
GROCERY_DEFAULT_MONTHLY_BUDGET=600.00

# Default categories (comma-separated)
GROCERY_DEFAULT_CATEGORIES=produce,dairy,meat,frozen,pantry,cleaning,personal care,beverages

# Default units (comma-separated)
GROCERY_DEFAULT_UNITS=pieces,lbs,oz,gallons,boxes,cans,bottles,packages

# Enable automatic staples detection
GROCERY_AUTO_STAPLES_DETECTION=true

# Minimum purchase frequency for staples (purchases per 90 days)
GROCERY_STAPLES_MIN_FREQUENCY=3

# ===== BACKUP CONFIGURATION =====
# Enable automatic backups (json storage only)
MCP_BACKUP_ENABLED=true

# Maximum number of backup files to keep
MCP_BACKUP_MAX_FILES=5

# ===== DEVELOPMENT/DEBUGGING =====
# Enable debug logging
MCP_DEBUG=false

# Enable verbose price tracking logging
GROCERY_DEBUG_PRICE_TRACKING=false

# Enable verbose receipt processing logging
GROCERY_DEBUG_RECEIPT_PROCESSING=false

# ===== WEB UI CONFIGURATION =====
# Base URL for web UI sessions (for Tailscale, VPN, etc.)
# Default: localhost (for local access only)
# 
# IMPORTANT: When using non-localhost URLs, the server automatically binds to 
# all interfaces (0.0.0.0) so it can be accessed via the specified IP/hostname
#
# Examples:
#   MCP_WEB_UI_BASE_URL=localhost           # Local access only (binds to localhost)
#   MCP_WEB_UI_BASE_URL=100.64.0.100        # Tailscale IP (binds to 0.0.0.0)
#   MCP_WEB_UI_BASE_URL=myserver.tailnet.ts # Tailscale hostname (binds to 0.0.0.0)
#   MCP_WEB_UI_BASE_URL=192.168.1.100       # Local network IP (binds to 0.0.0.0)
MCP_WEB_UI_BASE_URL=localhost

# ===== EXTERNAL SERVICES =====
# OCR Service for receipt processing (optional)
OCR_SERVICE_API_KEY=your-ocr-service-api-key
OCR_SERVICE_URL=https://api.ocr-service.com/v1/process

# Price comparison API (optional)
PRICE_COMPARISON_API_KEY=your-price-api-key
PRICE_COMPARISON_API_URL=https://api.price-service.com/v1/compare

# ===== NOTIFICATION SETTINGS =====
# Enable email notifications for budget alerts
GROCERY_EMAIL_NOTIFICATIONS=false
GROCERY_EMAIL_SMTP_HOST=smtp.gmail.com
GROCERY_EMAIL_SMTP_PORT=587
GROCERY_EMAIL_USERNAME=your-email@gmail.com
GROCERY_EMAIL_PASSWORD=your-app-password

# ===== ADVANCED FEATURES =====
# Enable AI-powered categorization suggestions
GROCERY_AI_CATEGORIZATION=false

# Enable predictive shopping suggestions
GROCERY_PREDICTIVE_SUGGESTIONS=true

# Enable multi-store price comparison
GROCERY_MULTI_STORE_COMPARISON=true

# Enable family sharing features
GROCERY_FAMILY_SHARING=false 