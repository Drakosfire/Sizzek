# Scheduled Tasks MCP Server Configuration

# ===== STORAGE CONFIGURATION =====
# Storage type: 'json' or 'mongodb'
MCP_STORAGE_TYPE=mongodb

# ===== JSON FILE STORAGE (when MCP_STORAGE_TYPE=json) =====
# Path to tasks file (relative or absolute)
TASKS_FILE_PATH=./tasks.json

# Enable automatic backups (json storage only)
MCP_BACKUP_ENABLED=true

# Maximum number of backup files to keep
MCP_BACKUP_MAX_FILES=30

# Backup interval in minutes
MCP_BACKUP_INTERVAL=60

# ===== MONGODB STORAGE (when MCP_STORAGE_TYPE=mongodb) =====
# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/LibreChat

# MongoDB database name (default: LibreChat)
MONGODB_DATABASE=LibreChat

# MongoDB collection name for scheduled tasks data
MONGODB_COLLECTION=scheduled_tasks

# MongoDB connection timeout (milliseconds)
MCP_MONGODB_TIMEOUT=10000

# MongoDB max retries
MCP_MONGODB_RETRIES=3

# ===== USER ISOLATION =====
# Enable user-based storage (set by LibreChat)
MCP_USER_BASED=true

# User ID (passed by LibreChat automatically)
MCP_USER_ID=default

# ===== ENCRYPTION (Optional - for sensitive task data) =====
# Encryption key (64-character hex string)
# Uses LibreChat's CREDS_KEY if available
CREDS_KEY=your-encryption-key-here

# ===== LIBRECHAT INTEGRATION =====
# LibreChat API endpoint
LIBRECHAT_ENDPOINT=http://localhost:3080

# LibreChat API key for sending messages
LIBRECHAT_API_KEY=your-librechat-api-key-here

# Agent Configuration (Required for dynamic user lookup)
LIBRECHAT_AGENT_NAME=sizzek
LIBRECHAT_AGENT_ID=default
LIBRECHAT_AGENT_MODEL=gpt-4o

# Default conversation ID (optional - deprecated in favor of dynamic user lookup)
# LIBRECHAT_CONVERSATION_ID=your-hardcoded-conversation-id

# HTTP timeout for LibreChat requests (milliseconds)
HTTP_TIMEOUT=30000

# Retry configuration
RETRY_ATTEMPTS=3
RETRY_DELAY=1000

# ===== DEVELOPMENT/DEBUGGING =====
# Enable debug logging
MCP_DEBUG=false

# Example configurations:

# === For Development (JSON files) ===
# MCP_STORAGE_TYPE=json
# TASKS_FILE_PATH=./tasks.json
# MCP_USER_BASED=false
# MCP_BACKUP_ENABLED=true

# === For Production with LibreChat (MongoDB) ===
# MCP_STORAGE_TYPE=mongodb
# MONGO_URI=mongodb://localhost:27017/LibreChat
# MONGODB_DATABASE=LibreChat
# MONGODB_COLLECTION=scheduled_tasks
# MCP_USER_BASED=true
# MCP_USER_ID=${USER_ID}  # LibreChat passes user ID
# CREDS_KEY=${CREDS_KEY}  # LibreChat encryption key

# === For Testing MongoDB locally ===
# MCP_STORAGE_TYPE=mongodb
# MONGO_URI=mongodb://localhost:27017/test_scheduled_tasks
# MONGODB_DATABASE=test_scheduled_tasks
# MONGODB_COLLECTION=tasks
# MCP_USER_ID=test-user 

# ===== GATEWAY PROXY CONFIGURATION =====
# When enabled, all web UI sessions route through a central gateway instead of individual ports
# This eliminates the need for port range mapping (12000-13000) in Docker
MCP_WEB_UI_USE_GATEWAY=false

# Gateway server URL - where the gateway proxy is running
# Default: http://localhost:3082 (matches gateway proxy default)
MCP_WEB_UI_GATEWAY_URL=http://localhost:3082

# Proxy URL prefix - the path prefix used in gateway URLs
MCP_WEB_UI_PROXY_PREFIX=/mcp

# Base URL for web UI sessions
MCP_WEB_UI_BASE_URL=localhost

# Bind address for web UI servers (localhost for gateway mode, 0.0.0.0 for direct mode)
MCP_WEB_UI_BIND_ADDRESS=localhost

# Port range for direct mode (when gateway is disabled)
MCP_WEB_UI_PORT_MIN=12000
MCP_WEB_UI_PORT_MAX=13000

# MongoDB URL for gateway session storage (when using gateway mode)
MCP_WEB_UI_MONGO_URL=mongodb://localhost:27017

# MongoDB database name for gateway sessions
MCP_WEB_UI_MONGO_DB_NAME=mcp_webui

# JWT secret for gateway session tokens
MCP_WEB_UI_JWT_SECRET=your-jwt-secret-key-here