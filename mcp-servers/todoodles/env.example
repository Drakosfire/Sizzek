# Todoodles MCP Server Configuration

# ===== STORAGE CONFIGURATION =====
# Storage type: 'json' or 'mongodb'
MCP_STORAGE_TYPE=json

# ===== JSON FILE STORAGE (when MCP_STORAGE_TYPE=json) =====
# Path to todoodles file (relative or absolute)
TODOS_FILE_PATH=./todoodle.json

# ===== MONGODB STORAGE (when MCP_STORAGE_TYPE=mongodb) =====
# MongoDB connection string
MONGODB_CONNECTION_STRING=mongodb://localhost:27017/LibreChat

# MongoDB database name (default: LibreChat)
MONGODB_DATABASE=LibreChat

# MongoDB collection name for todoodles data
MONGODB_COLLECTION=user_todoodles

# MongoDB connection timeout (milliseconds)
MCP_MONGODB_TIMEOUT=10000

# MongoDB max retries
MCP_MONGODB_RETRIES=3

# ===== USER ISOLATION =====
# Enable user-based storage (set by LibreChat)
MCP_USER_BASED=true

# User ID (passed by LibreChat automatically)
MCP_USER_ID=${USER_ID}

# ===== ENCRYPTION (Optional - for sensitive todo data) =====
# Encryption key (64-character hex string)
# Uses LibreChat's CREDS_KEY if available
CREDS_KEY=your-64-character-hex-encryption-key

# ===== BACKUP CONFIGURATION =====
# Enable automatic backups (json storage only)
MCP_BACKUP_ENABLED=true

# Maximum number of backup files to keep
MCP_BACKUP_MAX_FILES=5

# ===== DEVELOPMENT/DEBUGGING =====
# Enable debug logging
MCP_DEBUG=false

# ===== WEB UI CONFIGURATION =====
# Base URL for web UI sessions (for Tailscale, VPN, etc.)
# Default: localhost (for local access only)
# 
# IMPORTANT: When using non-localhost URLs, the server automatically binds to 
# all interfaces (0.0.0.0) so it can be accessed via the specified IP/hostname
#
# Examples:
#   MCP_WEB_UI_BASE_URL=localhost           # Local access only (binds to localhost)
#   MCP_WEB_UI_BASE_URL=100.64.0.100        # Tailscale IP (binds to 0.0.0.0)
#   MCP_WEB_UI_BASE_URL=myserver.tailnet.ts # Tailscale hostname (binds to 0.0.0.0)
#   MCP_WEB_UI_BASE_URL=192.168.1.100       # Local network IP (binds to 0.0.0.0)
MCP_WEB_UI_BASE_URL=localhost

# Example configurations:

# === For Development (JSON files) ===
# MCP_STORAGE_TYPE=json
# TODOS_FILE_PATH=./todoodle.json
# MCP_USER_BASED=false

# === For Production with LibreChat (MongoDB) ===
# MCP_STORAGE_TYPE=mongodb
# MONGODB_CONNECTION_STRING=mongodb://localhost:27017/LibreChat
# MONGODB_DATABASE=LibreChat
# MONGODB_COLLECTION=user_todoodles
# MCP_USER_BASED=true
# MCP_USER_ID=${USER_ID}  # LibreChat passes user ID

# === For Testing MongoDB locally ===
# MCP_STORAGE_TYPE=mongodb
# MONGODB_CONNECTION_STRING=mongodb://localhost:27017/test_todoodles
# MONGODB_DATABASE=test_todoodles
# MONGODB_COLLECTION=user_todoodles
# MCP_USER_ID=test-user 