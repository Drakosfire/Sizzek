{
  "name": "todoodles",
  "version": "2.1.0",
  "description": "A time-stamped todo list MCP server with categories, priorities, and due dates",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "npm run build && mocha 'tests/**/*.test.js' --timeout 30000 --exit",
    "test:unit": "npm run build && mocha 'tests/unit/**/*.test.js' --timeout 30000 --exit",
    "test:integration": "npm run build && mocha 'tests/integration/**/*.test.js' --timeout 30000 --exit",
    "test:watch": "npm run build && mocha 'tests/**/*.test.js' --timeout 30000 --watch",
    "test:cleanup": "node tests/helpers/cleanup-test-data.js"
  },
  "keywords": [
    "mcp",
    "todo",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.1",
    "mcp-data": "^1.0.1",
    "mcp-web-ui": "^1.1.0",
    "dotenv": "^16.5.0"
  },
  "devDependencies": {
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.24",
    "chai": "^4.3.10",
    "esmock": "^2.7.0",
    "mocha": "^10.2.0",
    "typescript": "^5.3.3"
  }
}