# Memory MCP Server Configuration

# ===== STORAGE CONFIGURATION =====
# Storage type: 'json' or 'mongodb'
MCP_STORAGE_TYPE=json

# ===== JSON FILE STORAGE (when MCP_STORAGE_TYPE=json) =====
# Path to memory file (relative or absolute)
MEMORY_FILE_PATH=./Sizzek/memory_files/memory.json

# ===== MONGODB STORAGE (when MCP_STORAGE_TYPE=mongodb) =====
# MongoDB connection string
MONGO_URI=mongodb://mongodb:27017/mcp-data

# MongoDB database name (default: mcp-data)
MONGODB_DATABASE=mcp-data

# MongoDB collection name for memory data
MONGODB_COLLECTION=user_memory

# MongoDB connection timeout (milliseconds)
MCP_MONGODB_TIMEOUT=10000

# MongoDB max retries
MCP_MONGODB_RETRIES=3

# ===== ENCRYPTION (Optional - for sensitive memory data) =====
# Encryption key (64-character hex string)
# Uses LibreChat's CREDS_KEY if available
CREDS_KEY=your-64-character-hex-encryption-key

# ===== BACKUP CONFIGURATION =====
# Enable automatic backups (json storage only)
MCP_BACKUP_ENABLED=true

# ===== DEVELOPMENT/DEBUGGING =====
# Enable debug logging
MCP_DEBUG=false

# Example configurations:

# === For Development (JSON files) ===
# MCP_STORAGE_TYPE=json
# MEMORY_FILE_PATH=./memory.json

# === For Production with LibreChat (MongoDB) ===
# MCP_STORAGE_TYPE=mongodb
# MONGO_URI=mongodb://mongodb:27017/mcp-data
# MONGODB_DATABASE=mcp-data
# MONGODB_COLLECTION=user_memory
# MCP_USER_ID=${USER_ID}  # LibreChat passes phone number
# CREDS_KEY=${CREDS_KEY}  # LibreChat's encryption key

# === For Production Standalone (MongoDB) ===  
# MCP_STORAGE_TYPE=mongodb
# MONGO_URI=mongodb://localhost:27017/mcp-data
# MONGODB_DATABASE=mcp-data
# MONGODB_COLLECTION=user_memory
# MCP_USER_ID=standalone-user 