# Common Variables

# LibreChat Integration

LIBRECHAT_ENDPOINT=http://localhost:3080
LIBRECHAT_API_KEY=
LIBRECHAT_CONVERSATION_ID=

# Agent Config
LIBRECHAT_AGENT_NAME=Sizzek
LIBRECHAT_AGENT_ID=agent_p2bFrXXxlb5Ud8WjzGrek
LIBRECHAT_AGENT_MODEL=gpt-4.1

# Twilio Configuration

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TEST_PHONE_NUMBER=
EXTERNAL_MESSAGE_API_KEY=

# ===== STORAGE CONFIGURATION =====
# Storage type: 'json' or 'mongodb'
MCP_STORAGE_TYPE=mongodb

# ===== JSON FILE STORAGE (when MCP_STORAGE_TYPE=json) =====
# Path to todoodles file (relative or absolute)

# ===== MONGODB STORAGE (when MCP_STORAGE_TYPE=mongodb) =====
# MongoDB connection string (without database name - database specified separately)
MONGO_URI=mongodb://librechat_user:${MONGO_PASSWORD}@mongodb:27017?authSource=LibreChat

# MongoDB database name for MCP servers (separate from LibreChat database)
MONGODB_DATABASE=mcp_data

# MongoDB connection timeout (milliseconds)
MCP_MONGODB_TIMEOUT=10000

# MongoDB max retries
MCP_MONGODB_RETRIES=3

# ===== USER ISOLATION =====
# Enable user-based storage (set by LibreChat)
MCP_USER_BASED=true

# ===== ENCRYPTION (Optional - for sensitive todo data) =====
# Encryption key (64-character hex string)
# Uses LibreChat's CREDS_KEY if available
CREDS_KEY=your-64-character-hex-encryption-key

# ===== BACKUP CONFIGURATION =====
# Enable automatic backups (json storage only)
MCP_BACKUP_ENABLED=true

# Maximum number of backup files to keep
MCP_BACKUP_MAX_FILES=5

# ===== WEB UI BASE URL =====
MCP_WEB_UI_BASE_URL=https://sizzek.dungeonmind.net
# MCP_WEB_UI_CSS_PATH=~/projects/Sizzek/mcp-servers/grocery-list/static

# ===== DEVELOPMENT/DEBUGGING =====
# Enable debug logging
MCP_DEBUG=true

# Example configurations:

# === For Development (JSON files) ===
# MCP_STORAGE_TYPE=json
# TODOS_FILE_PATH=./todoodle.json
# MCP_USER_BASED=false

# === For Production with LibreChat (MongoDB) ===
# MCP_STORAGE_TYPE=mongodb
# MONGO_URI=mongodb://localhost:27017/LibreChat
# MONGODB_DATABASE=LibreChat
# MONGODB_COLLECTION=user_todoodles
# MCP_USER_BASED=true
# MCP_USER_ID=${USER_ID}  # LibreChat passes user ID

# === For Testing MongoDB locally ===
# MCP_STORAGE_TYPE=mongodb
# MONGO_URI=mongodb://localhost:27017/test_todoodles
# MONGODB_DATABASE=test_todoodles
# MONGODB_COLLECTION=user_todoodles
# MCP_USER_ID=test-user 
# ===== EPHEMERAL WEB UI PORT RANGE =====
# Port range for ephemeral web UI servers (must match firewall rules)
MCP_WEB_UI_PORT_MIN=11000
MCP_WEB_UI_PORT_MAX=12000

# Todoodles MCP Server Configuration
# MongoDB collection name for todoodles data
TODOODLES_MONGODB_COLLECTION=user_todoodles
# Google Calender MCP 
GOOGLE_CLOUD_CLIENT_ID=
GOOGLE_CLOUD_CLIENT_SECRET=

# ===== MEMORY CONFIGURATION =====
# MongoDB Configuration - FIXED
MEMORY_MONGODB_COLLECTION_PREFIX=mcp_memory
# Path to memory file (when using JSON storage)
MEMORY_FILE_PATH=./Sizzek/memory_files/memory.json
# Storage Type Configuration
MEMORY_MCP_STORAGE_TYPE=paginated-graph
# Memory backup configuration
MEMORY_BACKUP_ENABLED=true
MEMORY_BACKUP_MAX_FILES=5

# Memory debug settings
MEMORY_DEBUG=false
MEMORY_DEBUG_GRAPH=false
MEMORY_DEBUG_STORAGE=false

# Memory performance settings
MEMORY_MAX_ENTITIES_PER_USER=10000
MEMORY_MAX_RELATIONS_PER_USER=50000
MEMORY_MAX_OBSERVATIONS_PER_ENTITY=1000

# Memory graph settings
MEMORY_GRAPH_PAGE_SIZE=100
MEMORY_GRAPH_MAX_DEPTH=10
MEMORY_GRAPH_RELATION_STRENGTH_DECAY=0.9

# Memory cleanup settings
MEMORY_AUTO_CLEANUP=false
MEMORY_CLEANUP_INTERVAL_HOURS=24
MEMORY_MAX_AGE_DAYS=365

# MongoDB collection name for Movies data
MOVIES_MONGODB_COLLECTION=user_movies

# ===== MOVIES ADDITIONAL CONFIGURATION =====
# Directory for all movies JSON data files (relative or absolute)
MCP_MOVIES_DATA_DIR=./data

# Movies-specific storage configuration
MOVIES_MONGODB_COLLECTION=user_movies

# Movies web UI configuration
WEB_UI_PORT=3000
WEB_UI_HOST=localhost

# Movies development settings
DEBUG=movies:*

# Movies-specific features
MOVIES_ENABLE_RECOMMENDATIONS=true
MOVIES_ENABLE_RATINGS=true
MOVIES_ENABLE_WATCHLIST=true
MOVIES_ENABLE_HISTORY=true

# Movies data settings
MOVIES_MAX_ITEMS_PER_USER=1000
MOVIES_MAX_RATINGS_PER_USER=5000
MOVIES_MAX_WATCHLIST_ITEMS=100

# Movies API settings (optional)
MOVIES_TMDB_API_KEY=your-tmdb-api-key
MOVIES_TMDB_BASE_URL=https://api.themoviedb.org/3
MOVIES_OMDB_API_KEY=your-omdb-api-key
MOVIES_OMDB_BASE_URL=http://www.omdbapi.com

# Movies cache settings
MOVIES_CACHE_ENABLED=true
MOVIES_CACHE_TTL_HOURS=24
MOVIES_CACHE_MAX_SIZE=1000

# Movies import/export settings
MOVIES_ENABLE_IMPORT=true
MOVIES_ENABLE_EXPORT=true
MOVIES_IMPORT_FORMATS=csv,json
MOVIES_EXPORT_FORMATS=csv,json

# Scheduled Tasks MCP Configuration
TODODLES_MONGODB_COLLECTION=user_todoodles
# MongoDB collection name for todoodles data
SCHEDULED_TASKS_MONGODB_COLLECTION=user_scheduled_tasks

# ===== SCHEDULED TASKS ADDITIONAL CONFIGURATION =====
# Path to tasks file (when using JSON storage)
TASKS_FILE_PATH=./tasks.json

# Backup interval in minutes
MCP_BACKUP_INTERVAL=60

# HTTP timeout for LibreChat requests (milliseconds)
HTTP_TIMEOUT=30000

# Retry configuration
RETRY_ATTEMPTS=3
RETRY_DELAY=1000

# Migration settings
MCP_AUTO_MIGRATE=true
MCP_KEEP_MIGRATION_BACKUP=true
MCP_MIGRATION_DEBUG=false

# MongoDB database name for user lookup service
MONGODB_LIBRECHAT_DB=LibreChat

# ===== GROCERY LIST CONFIGURATION =====
# MongoDB collection name for groceries data
GROCERY_LIST_MONGODB_COLLECTION=user_groceries
# Path to grocery data file (when using JSON storage)
GROCERY_FILE_PATH=./grocery-data.json

# Grocery-specific features
GROCERY_DEFAULT_STORE=Kroger
GROCERY_ENABLE_PRICE_TRACKING=true
GROCERY_ENABLE_RECEIPT_PROCESSING=true
GROCERY_BUDGET_ALERTS=true
GROCERY_DEFAULT_MONTHLY_BUDGET=600.00
GROCERY_DEFAULT_CATEGORIES=produce,dairy,meat,frozen,pantry,cleaning,personal care,beverages
GROCERY_DEFAULT_UNITS=pieces,lbs,oz,gallons,boxes,cans,bottles,packages
GROCERY_AUTO_STAPLES_DETECTION=true
GROCERY_STAPLES_MIN_FREQUENCY=3

# Grocery debug settings
GROCERY_DEBUG_PRICE_TRACKING=false
GROCERY_DEBUG_RECEIPT_PROCESSING=false

# Grocery advanced features
GROCERY_AI_CATEGORIZATION=false
GROCERY_PREDICTIVE_SUGGESTIONS=true
GROCERY_MULTI_STORE_COMPARISON=true
GROCERY_FAMILY_SHARING=false

# Grocery notification settings
GROCERY_EMAIL_NOTIFICATIONS=false
GROCERY_EMAIL_SMTP_HOST=smtp.gmail.com
GROCERY_EMAIL_SMTP_PORT=587
GROCERY_EMAIL_USERNAME=your-email@gmail.com
GROCERY_EMAIL_PASSWORD=your-app-password

# Grocery external services (optional)
OCR_SERVICE_API_KEY=your-ocr-service-api-key
OCR_SERVICE_URL=https://api.ocr-service.com/v1/process
PRICE_COMPARISON_API_KEY=your-price-api-key
PRICE_COMPARISON_API_URL=https://api.price-service.com/v1/compare

