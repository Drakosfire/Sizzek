[Unit]
Description=MCP Gateway Proxy Server (Security Hardened)
After=network.target docker.service
Requires=docker.service
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=5

# 🔐 Security: Run as dedicated user instead of root
User=mcp-gateway
Group=docker

# 🔐 Security: Restrict working directory and make it read-only
WorkingDirectory=/opt/mcp-gateway
ReadOnlyPaths=/opt/mcp-gateway
ReadWritePaths=/opt/mcp-gateway/logs /tmp

# 🔐 Security: Environment restrictions
Environment=NODE_ENV=production
Environment=DEBUG=false
# Remove sensitive environment variables
UnsetEnvironment=SUDO_USER SUDO_UID SUDO_GID

# 🔐 Security: Resource limits
LimitNOFILE=1024
LimitNPROC=100
MemoryMax=512M
CPUQuota=50%

# 🔐 Security: Network restrictions
IPAccounting=true
IPAddressAllow=127.0.0.1/8 172.16.0.0/12 10.0.0.0/8
IPAddressDeny=any

# 🔐 Security: Filesystem restrictions
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid

# 🔐 Security: Capability restrictions
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# 🔐 Security: Namespace isolation
PrivateTmp=true
PrivateDevices=true
PrivateUsers=false  # Needs to be false for Docker access
ProtectHostname=true
ProtectClock=true
ProtectKernelLogs=true
RestrictRealtime=true
RestrictSUIDSGID=true

# 🔐 Security: System call filtering
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount
SystemCallErrorNumber=EPERM

# 🔐 Security: Restrict access to namespaces
RestrictNamespaces=~CLONE_NEWUSER

# Service execution
ExecStartPre=/usr/local/bin/mcp-gateway-pre-start.sh
ExecStart=/usr/local/bin/mcp-gateway-start.sh
ExecStop=/usr/local/bin/mcp-gateway-stop.sh
ExecReload=/bin/kill -HUP $MAINPID

# 🔐 Security: Logging (avoid sensitive data)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mcp-gateway
SyslogLevel=info

[Install]
WantedBy=multi-user.target
